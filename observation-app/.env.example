# Postgres connection string from Supabase:
# Project Settings -> Database -> Connection string -> "Transaction pooler" (port 6543)
DATABASE_URL=postgres://postgres.xxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Long random string that signs device cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=

# The shared passcode (recommended). If blank, the first person to open the app creates it.
INITIAL_PASSCODE=
# Optional. Only used if you turn on "require the private link" in Settings -> Access.
# The link is then https://<your-app>/enter/<INITIAL_ACCESS_KEY>. Letters and numbers only.
INITIAL_ACCESS_KEY=

# Optional: true adds 18 fake "Sample" residents with observations, for testing. Remove before launch.
SEED_SAMPLE_DATA=

# Time zone used for "today" and cycle assignment.
APP_TIME_ZONE=America/New_York
