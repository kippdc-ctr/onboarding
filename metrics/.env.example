# Postgres connection string from Supabase (can be the same project as the Onboarding Hub;
# this app keeps its tables in a separate "metrics" schema).
# Project Settings -> Database -> Connection string -> "Transaction pooler" (port 6543)
DATABASE_URL=postgres://postgres.xxxx:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Comma-separated emails added as Owners on every deploy (never removed or downgraded by the deploy).
OWNER_EMAILS=

# Temporary password (10+ characters) given to an owner from OWNER_EMAILS who has no password yet.
# The owner must choose their own at first sign-in. You can delete this variable afterwards.
OWNER_INITIAL_PASSWORD=

# Long random string used to sign session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Optional: only allow adding users with emails on this domain (e.g. kippdc.org).
ALLOWED_EMAIL_DOMAIN=

# Time zone used for "today" (status windows, data-through defaults).
APP_TIME_ZONE=America/New_York
